VITE_API_BASE_URL=/api/v1
VITE_API_PROXY=http://localhost:8080
# Toss Payments client key (public). Empty = checkout shows "not ready" and
# orders fail closed server-side with 503 until TOSS_SECRET_KEY is set.
VITE_TOSS_CLIENT_KEY=
# ---- E-commerce business identity (footer; hidden until set) ----
VITE_BUSINESS_NAME=
VITE_BUSINESS_CEO=
VITE_BUSINESS_ADDRESS=
VITE_BUSINESS_TEL=
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_REG_NO=
VITE_BUSINESS_MAILORDER_NO=
VITE_BUSINESS_HOSTING=
# OSP takedown recipient (Copyright Act §103). Shown in the footer when set.
VITE_OSP_CONTACT_EMAIL=
