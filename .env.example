# ---- Database (PostgreSQL 16) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=avibe
DB_USER=avibe
DB_PASSWORD=change-me-db-password
DB_DSN=postgres://avibe:change-me-db-password@localhost:5432/avibe?sslmode=disable

# ---- Redis 7 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# ---- Local S3-compatible storage (LocalStack; containers use http://localstack:4566) ----
S3_PORT=4566
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY=localstack_dummy_access
S3_SECRET_KEY=localstack_dummy_secret
S3_USE_SSL=false
S3_STAGING_BUCKET=local-staging
S3_PUBLIC_HLS_BUCKET=local-hls
# HLS playback base for local: served straight from the LocalStack public bucket.
CDN_BASE_URL=http://localhost:4566/local-hls

# ---- API ----
API_PORT=8080
APP_ENV=local
APP_ADDR=:8080

# ---- Auth secrets (generate fresh values; never commit real ones) ----
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# AES-256 key for settlement account encryption (exactly 32 bytes, base64 of 32 bytes).
# Generate: openssl rand -base64 32
AES256_KEY_BASE64=change-me-32-byte-base64-aes-key-0123456789ab==

# HLS URL signing key (short-lived signed playback URLs).
# Generate: openssl rand -hex 32
HLS_SIGNING_KEY=change-me-hls-signing-key-hex-64-chars-minimum-0000000000000000
HLS_URL_TTL_SECONDS=300

# ---- HTTP hardening ----
# Comma-separated exact origins allowed for CORS (empty = same-origin only).
CORS_ALLOWED_ORIGINS=
# Comma-separated trusted proxy CIDRs/IPs for X-Forwarded-For (empty = trust none).
TRUSTED_PROXIES=

# ---- Web frontend origin (reset links, OAuth redirects) ----
FRONTEND_BASE_URL=http://localhost:5173

# ---- Password reset ----
PASSWORD_RESET_TTL_MINUTES=30

# ---- Social login (Google / Kakao); a provider enables when ID + secret are set ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# API-side OAuth callback base (register {base}/{google|kakao}/callback at each provider).
OAUTH_REDIRECT_BASE_URL=http://localhost:8080/api/v1/auth/oauth
# Signs OAuth state tokens (falls back to JWT_ACCESS_SECRET when empty).
# Generate: openssl rand -hex 32
OAUTH_STATE_SECRET=

# ---- Toss Payments billing (empty secret = billing endpoints return 503) ----
TOSS_SECRET_KEY=
# TOSS_API_BASE_URL=https://api.tosspayments.com

# ---- Outbound mail (empty SMTP_HOST = log-only delivery for local/dev) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@avibe.kr
MAIL_FROM_NAME=AVIBE

# ---- Cloudflare R2 / CDN template (NOT used in Phase 1 local; uncomment in staging/prod) ----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_STAGING_BUCKET=staging-private
# R2_PUBLIC_HLS_BUCKET=public-hls
# CDN_BASE_URL=https://cdn.example.com
# CDN_HLS_KEY_ID=
# CDN_HLS_SIGNING_KEY=
