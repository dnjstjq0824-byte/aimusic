# ---- Database (PostgreSQL 16) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=avibe
DB_USER=avibe
DB_PASSWORD=change-me-db-password
DB_DSN=postgres://avibe:change-me-db-password@localhost:5432/avibe?sslmode=disable

# ---- Redis 7 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# ---- Local S3-compatible storage (LocalStack; containers use http://localstack:4566) ----
S3_PORT=4566
S3_ENDPOINT=http://localhost:4566
# Public endpoint for URLs handed to browsers (presigned uploads, DSP links).
# Empty = same as S3_ENDPOINT. Prod: S3_ENDPOINT internal, this = https://hls.avibemusic.com
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=localstack_dummy_access
S3_SECRET_KEY=localstack_dummy_secret
S3_USE_SSL=false
S3_STAGING_BUCKET=local-staging
S3_PUBLIC_HLS_BUCKET=local-hls
# HLS playback base for local: served straight from the LocalStack public bucket.
CDN_BASE_URL=http://localhost:4566/local-hls

# ---- API ----
API_PORT=8080
APP_ENV=local
APP_ADDR=:8080

# ---- Launch gate (C8): when set, registration requires this invite code ----
# Leave empty for open registration (local/dev). Set in staging/prod until
# launch blockers (docs/legal/LAUNCH_COMPLIANCE.md) are resolved.
REGISTRATION_INVITE_CODE=

# ---- Auth secrets (generate fresh values; never commit real ones) ----
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# AES-256 key for settlement account encryption (exactly 32 bytes, base64 of 32 bytes).
# Generate: openssl rand -base64 32
# The placeholder below is intentionally undecodable: start-local.sh mints a
# real dev-only key on first copy, and anything else fails closed in Load.
AES256_KEY_BASE64=change-me-32-byte-base64-aes-key-0123456789ab==

# HLS URL signing key (short-lived signed playback URLs).
# Generate: openssl rand -hex 32
HLS_SIGNING_KEY=change-me-hls-signing-key-hex-64-chars-minimum-0000000000000000
HLS_URL_TTL_SECONDS=300

# ---- HTTP hardening ----
# Comma-separated exact origins allowed for CORS (empty = same-origin only).
CORS_ALLOWED_ORIGINS=
# Comma-separated trusted proxy CIDRs/IPs for X-Forwarded-For (empty = trust none).
TRUSTED_PROXIES=

# ---- Web frontend origin (reset links, OAuth redirects) ----
FRONTEND_BASE_URL=http://localhost:5173

# ---- Password reset ----
PASSWORD_RESET_TTL_MINUTES=30

# ---- Email verification (WI-A2; links point at FRONTEND_BASE_URL/verify-email) ----
EMAIL_VERIFY_TTL_HOURS=24

# ---- Social login (Google / Kakao / Apple / Naver / LINE); a provider enables ----
# ---- when every required credential is set (Kakao secret is optional). ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# API-side OAuth callback base (register {base}/{google|kakao|apple|naver|line}/callback at each provider).
OAUTH_REDIRECT_BASE_URL=http://localhost:8080/api/v1/auth/oauth
# Signs OAuth state tokens (falls back to JWT_ACCESS_SECRET when empty).
# Generate: openssl rand -hex 32
OAUTH_STATE_SECRET=

# ---- Toss Payments billing (empty secret = billing endpoints return 503) ----
TOSS_SECRET_KEY=
# TOSS_API_BASE_URL=https://api.tosspayments.com

# ---- Outbound mail (empty SMTP_HOST = log-only delivery for local/dev) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@avibemusic.com
MAIL_FROM_NAME=AVIBE
# Ops alert recipient for business inquiries (R7; empty = no mail, row only).
OPS_NOTIFY_EMAIL=

# ---- Cloudflare R2 storage (WI-D1; prod media backend) ----
# Set STORAGE_DRIVER=r2 to use R2 (backend/internal/pkg/storage NewFromEnv).
# R2 S3 API tokens come from the Cloudflare dashboard (R2 -> API tokens);
# put values in the real .env only, never in this template.
# STORAGE_DRIVER=r2
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_STAGING_BUCKET=staging-private
# R2_PUBLIC_HLS_BUCKET=public-hls
# Off-site DB backups (WI-N3; deploy/backup-db.sh uploads here, private bucket).
# R2_DB_BACKUP_BUCKET=avibe-db-backups
# Playback stays behind the Worker signature gate; CDN_BASE_URL is the Worker.
# CDN_BASE_URL=https://avibemusic.com/local-hls

# ---- Search exposure (WI-S1~S5; empty keys degrade gracefully, never fail) ----
SITE_BASE_URL=https://avibemusic.com
# IndexNow submission key (PO provisions; also served at /{key}.txt for proof).
INDEXNOW_KEY=
# INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
# INDEXNOW_DAILY_CAP=10000
# Cloudflare cache purge on content change (empty = SWR expiry only).
CF_CACHE_PURGE_TOKEN=
CF_ZONE_ID=
# Search-console verification tokens (public by design; meta/file slots).
# NUXT_PUBLIC_VERIFY_* render <meta> tags; the backend serves matching
# verification files from *_SITE_VERIFICATION (same token in both).
NUXT_PUBLIC_VERIFY_GOOGLE=
NUXT_PUBLIC_VERIFY_BING=
NUXT_PUBLIC_VERIFY_NAVER=
NUXT_PUBLIC_VERIFY_DAUM=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
DAUM_SITE_VERIFICATION=
# Cloudflare Web Analytics beacon (cookieless RUM complement).
NUXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# ---- Music generation backend (WI-03/WI-N12; empty URL = jobs fail closed) ----
# GENERATION_BACKEND_URL=http://<gpu-host>:8000
# Bearer token the worker sends to the generation server (must match the
# server's GENERATOR_API_TOKEN; empty = no Authorization header).
# GENERATION_BACKEND_TOKEN=
# GENERATION_TIMEOUT_SECONDS=600
# GENERATION_DAILY_CAP=5
# GENERATION_BANNED_KEYWORDS=
