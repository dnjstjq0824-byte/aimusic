# ---- Database (PostgreSQL 16) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_music
DB_USER=ai_music
DB_PASSWORD=change-me-db-password
DB_DSN=postgres://ai_music:change-me-db-password@localhost:5432/ai_music?sslmode=disable

# ---- Redis 7 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379

# ---- MinIO / S3-compatible storage (local) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio-password-min-8-chars
S3_USE_SSL=false
MINIO_STAGING_BUCKET=minio-staging
MINIO_PUBLIC_HLS_BUCKET=minio-public-hls

# ---- API ----
API_PORT=8080
APP_ENV=local
APP_ADDR=:8080

# ---- Auth secrets (generate fresh values; never commit real ones) ----
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32-chars
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

# AES-256 key for settlement account encryption (exactly 32 bytes, base64 of 32 bytes).
# Generate: openssl rand -base64 32
AES256_KEY_BASE64=change-me-32-byte-base64-aes-key-0123456789ab==

# HLS URL signing key (short-lived signed playback URLs).
# Generate: openssl rand -hex 32
HLS_SIGNING_KEY=change-me-hls-signing-key-hex-64-chars-minimum-0000000000000000
HLS_URL_TTL_SECONDS=300

# ---- Cloudflare R2 / CDN template (NOT used in Phase 1 local; uncomment in staging/prod) ----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_STAGING_BUCKET=staging-private
# R2_PUBLIC_HLS_BUCKET=public-hls
# CDN_BASE_URL=https://cdn.example.com
# CDN_HLS_KEY_ID=
# CDN_HLS_SIGNING_KEY=
