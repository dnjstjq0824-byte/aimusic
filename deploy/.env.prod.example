# AVIBE production env template (VPS /opt/avibe/.env). chmod 600.
# This file is tracked (placeholder values only) so fresh clones can see the
# full key set; real secrets live only in /opt/avibe/.env on the VPS.
# Generate secrets with: openssl rand -base64 48  (AES: openssl rand -base64 32)
APP_ENV=prod
APP_ADDR=:8080

DB_NAME=avibe
DB_USER=avibe
DB_PASSWORD=
# TLS is enforced by config.Validate in prod: keep sslmode=require (the
# server cert comes from ./pgcerts, provisioned by deploy/vps-init.sh).
DB_DSN=postgres://avibe:DB_PASSWORD_HERE@postgres:5432/avibe?sslmode=require
REDIS_ADDR=redis:6379

# >= 32 chars each (Validate refuses shorter in prod).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
HLS_SIGNING_KEY=
AES256_KEY_BASE64=

# Media storage is private Cloudflare R2 in prod (WI-D1). For local s3local
# dev see S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY/S3_USE_SSL (backend defaults).
STORAGE_DRIVER=r2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_STAGING_BUCKET=staging-private
R2_PUBLIC_HLS_BUCKET=public-hls
S3_REGION=auto
CDN_BASE_URL=https://avibemusic.com

# DB backup off-site copy (deploy/backup-db.sh from root crontab). The cron
# environment must also carry these (cron does not source /opt/avibe/.env);
# unset = local-only dumps with a warning.
R2_DB_BACKUP_BUCKET=

CORS_ALLOWED_ORIGINS=https://avibemusic.com
TRUSTED_PROXIES=172.30.0.0/16
FRONTEND_BASE_URL=https://avibemusic.com
# Note the /api/v1/auth/oauth suffix (the backend default); the bare host is wrong.
OAUTH_REDIRECT_BASE_URL=https://avibemusic.com/api/v1/auth/oauth
# Social login providers (all optional; unset providers stay disabled).
#OAUTH_STATE_SECRET=
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#KAKAO_CLIENT_ID=
#KAKAO_CLIENT_SECRET=
#APPLE_SERVICES_ID=
#APPLE_TEAM_ID=
#APPLE_KEY_ID=
#APPLE_PRIVATE_KEY=
#NAVER_CLIENT_ID=
#NAVER_CLIENT_SECRET=
#LINE_CHANNEL_ID=
#LINE_CHANNEL_SECRET=
# Optional invite gate for registration (empty = open).
#REGISTRATION_INVITE_CODE=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@avibemusic.com
MAIL_FROM_NAME=AVIBE
OPS_NOTIFY_EMAIL=

TOSS_SECRET_KEY=

# Music generation backend (RunPod). Empty URL = generation calls fail closed.
#GENERATION_BACKEND_URL=
#GENERATION_BACKEND_TOKEN=
#GENERATION_TIMEOUT_SECONDS=600
#GENERATION_DAILY_CAP=5

# SEO/ops knobs.
SITE_BASE_URL=https://avibemusic.com
INDEXNOW_KEY=
#CF_CACHE_PURGE_TOKEN=
#CF_ZONE_ID=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=
DAUM_SITE_VERIFICATION=

# Nuxt web container (docker-compose.prod.yml requires this, >= 32 chars).
NUXT_APP_SECRET=
